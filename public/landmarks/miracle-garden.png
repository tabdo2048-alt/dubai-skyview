    <noscript>
      <img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1411156253761642&ev=PageView&noscript=1"
      />
    </noscript>
    <!-- Global Preloader -->
    <div id="dmg-preloader" class="dmg-preloader">
      <img src="/assets/img/dmg-logo-color.png" alt="Dubai Miracle Garden" class="preloader-logo">
    </div>
    
    <div id="root"></div>
    
    <!-- Global Preloader Script -->
    <script type="b8232333f6705833e110a152-text/javascript">
      // Global preloader functionality
      function hideGlobalPreloader() {
        const preloader = document.getElementById('dmg-preloader');
        if (preloader) {
          preloader.classList.add('hidden');
          setTimeout(() => {
            if (preloader.parentNode) {
              preloader.parentNode.removeChild(preloader);
            }
          }, 500);
        }
        
        // Show body content
        document.body.classList.add('content-loaded');
      }
      
      // Hide preloader when page is fully loaded
      window.addEventListener('load', () => {
        setTimeout(hideGlobalPreloader, 500);
      });
      
      // Also hide preloader when DOM is ready (for faster pages)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setTimeout(hideGlobalPreloader, 500);
        });
      } else {
        setTimeout(hideGlobalPreloader, 500);
      }
      
      // Make function globally available
      window.hideGlobalPreloader = hideGlobalPreloader;
    </script>
