# Public/client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_URL=
MAPBOX_ACCESS_TOKEN=

# Where visitor inquiries go. VITE_CONTACT_WHATSAPP is an international number;
# punctuation is stripped, so "+971 58 662 0600" is fine. It falls back to the
# number the site shipped with, so the WhatsApp button always works.
#
# VITE_CONTACT_EMAIL has NO fallback on purpose: the value it replaced was a
# placeholder domain that silently swallowed every viewing request. Leave it unset
# and the "Book viewing" button is hidden; set it and the button appears.
VITE_CONTACT_EMAIL=
VITE_CONTACT_WHATSAPP=
# Optional: URL encoded in the QR shown in generated sales-offer PDFs.
# If empty, the PDF QR falls back to VITE_CONTACT_WHATSAPP.
VITE_OFFER_QR_URL=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Without it the app still
# calls track() at every conversion point, but the events go nowhere — no GA
# script is loaded and nothing is recorded.
VITE_GA_ID=

# Server-only configuration: never expose these through VITE_* variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
APP_URL=
GOOGLE_MAPS_API_KEY=
