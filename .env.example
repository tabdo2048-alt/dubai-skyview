# Public/client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_URL=
MAPBOX_ACCESS_TOKEN=
# Public, URL-restricted Cesium ion token. Local runtime geodata still works
# without it; ion-hosted assets remain disabled until this is configured.
VITE_CESIUM_ION_TOKEN=
# Explicit opt-in. false/unset makes ZERO Google Photorealistic requests.
VITE_ENABLE_GOOGLE_PHOTOREALISTIC=false
# Optional alternative to ion asset 2275207 access: HTTP-referrer restricted
# public browser key, API restriction = Google Map Tiles API only.
VITE_GOOGLE_MAP_TILES_API_KEY=
# Buffer owned project parcels for insertion (metres, clamped 0..20).
VITE_PROJECT_INSERT_PADDING_METERS=2

# Where visitor inquiries go. VITE_CONTACT_WHATSAPP is an international number;
# punctuation is stripped, so "+971 58 662 0600" is fine. It falls back to the
# number the site shipped with, so the WhatsApp button always works.
#
# VITE_CONTACT_EMAIL has NO fallback on purpose: the value it replaced was a
# placeholder domain that silently swallowed every viewing request. Leave it unset
# and the "Book viewing" button is hidden; set it and the button appears.
VITE_CONTACT_EMAIL=
VITE_CONTACT_WHATSAPP=
# Optional: URL encoded in the QR shown in generated sales-offer PDFs.
# If empty, the PDF QR falls back to VITE_CONTACT_WHATSAPP.
VITE_OFFER_QR_URL=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Without it the app still
# calls track() at every conversion point, but the events go nowhere — no GA
# script is loaded and nothing is recorded.
VITE_GA_ID=

# Server-only configuration: never expose these through VITE_* variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
APP_URL=
GOOGLE_MAPS_API_KEY=

# Cloudinary project-video uploads. All three are server-only; never prefix them
# with VITE_ or expose CLOUDINARY_API_SECRET in browser code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
