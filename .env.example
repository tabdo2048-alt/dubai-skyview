# Public/client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_URL=
MAPBOX_ACCESS_TOKEN=

# Where visitor inquiries go. An unset value HIDES the matching button rather
# than rendering one that goes nowhere. VITE_CONTACT_WHATSAPP is an international
# number; punctuation is stripped, so "+971 58 662 0600" is fine.
VITE_CONTACT_EMAIL=
VITE_CONTACT_WHATSAPP=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Without it the app still
# calls track() at every conversion point, but the events go nowhere — no GA
# script is loaded and nothing is recorded.
VITE_GA_ID=

# Server-only configuration: never expose these through VITE_* variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
APP_URL=
GOOGLE_MAPS_API_KEY=
