{
  "name": "dubai-skyview",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:unit-offers": "esbuild scripts/verify-unit-offers.tsx --bundle --platform=node --format=esm --packages=external --outfile=artifacts/unit-offer-check.mjs && node artifacts/unit-offer-check.mjs",
    "test:cesium-geodata": "esbuild scripts/verify-cesium-geodata.ts --bundle --platform=node --format=esm --packages=external --outfile=artifacts/cesium-geodata-check.mjs && node artifacts/cesium-geodata-check.mjs",
    "generate:water": "esbuild scripts/generate-water-geometry.ts --bundle --platform=node --format=cjs --outfile=.output/generate-water.cjs && node .output/generate-water.cjs",
    "generate:roads": "esbuild scripts/generate-roads.ts --bundle --platform=node --format=cjs --outfile=.output/generate-roads.cjs && node .output/generate-roads.cjs",
    "generate:rail": "esbuild scripts/generate-rail.ts --bundle --platform=node --format=cjs --outfile=.output/generate-rail.cjs && node .output/generate-rail.cjs",
    "generate:hospitals": "esbuild scripts/generate-hospitals.ts --bundle --platform=node --format=cjs --outfile=.output/generate-hospitals.cjs && node .output/generate-hospitals.cjs",
    "generate:schools": "esbuild scripts/generate-schools.ts --bundle --platform=node --format=cjs --outfile=.output/generate-schools.cjs && node .output/generate-schools.cjs",
    "generate:demo-district": "node scripts/generate-demo-district.mjs",
    "validate:water": "esbuild scripts/auditWaterOverlap.ts --bundle --platform=node --format=cjs --outfile=.output/audit-water.cjs && node .output/audit-water.cjs",
    "validate:metro": "esbuild scripts/validateMetro.ts --bundle --platform=node --format=cjs --outfile=.output/metro-validation.cjs && node .output/metro-validation.cjs",
    "verify:earcut": "esbuild scripts/earcut-check.ts --bundle --platform=node --format=cjs --outfile=.output/earcut-check.cjs && node .output/earcut-check.cjs",
    "verify:water": "esbuild scripts/screenshot-water.ts --bundle --platform=node --format=cjs --external:playwright --outfile=.output/screenshot-water.cjs && node .output/screenshot-water.cjs",
    "geodata:download:pilot": "esbuild scripts/geodata/download-osm-dubai.ts --bundle --platform=node --format=esm --packages=external --outfile=.output/geodata-download.mjs && node .output/geodata-download.mjs",
    "geodata:process:osm": "esbuild scripts/geodata/process-osm.ts --bundle --platform=node --format=esm --packages=external --outfile=.output/geodata-process-osm.mjs && node .output/geodata-process-osm.mjs",
    "geodata:generate": "esbuild scripts/geodata/generate-runtime-geodata.ts --bundle --platform=node --format=esm --packages=external --outfile=.output/geodata-generate.mjs && node .output/geodata-generate.mjs",
    "geodata:validate": "esbuild scripts/geodata/validate-geodata.ts --bundle --platform=node --format=esm --packages=external --outfile=.output/geodata-validate.mjs && node .output/geodata-validate.mjs",
    "geodata:pilot": "npm run geodata:download:pilot && npm run geodata:process:osm && npm run geodata:generate && npm run geodata:validate",
    "format": "prettier --write .",
    "test:photorealistic": "esbuild scripts/verify-photorealistic.ts --bundle --platform=node --format=esm --packages=external --outfile=artifacts/photorealistic-check.mjs && node artifacts/photorealistic-check.mjs",
    "test:virtual-tour-data": "esbuild scripts/verify-virtual-tour-data.ts --bundle --platform=node --format=esm --packages=external --outfile=artifacts/virtual-tour-data-check.mjs && node artifacts/virtual-tour-data-check.mjs",
    "test:virtual-tour-viewer": "esbuild scripts/verify-virtual-tour-viewer.ts --bundle --platform=node --format=esm --packages=external --outfile=artifacts/virtual-tour-viewer-check.mjs && node artifacts/virtual-tour-viewer-check.mjs",
    "test:virtual-tour-floors": "esbuild scripts/verify-virtual-tour-floors.ts --bundle --platform=node --format=esm --packages=external --outfile=artifacts/virtual-tour-floors-check.mjs && node artifacts/virtual-tour-floors-check.mjs",
    "test:virtual-tour-admin": "esbuild scripts/verify-virtual-tour-admin.ts --bundle --platform=node --format=esm --packages=external --outfile=artifacts/virtual-tour-admin-check.mjs && node artifacts/virtual-tour-admin-check.mjs"
  },
